{
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend",
      "routePrefix": "/_/backend"
    }
  },
  "regions": ["iad1"],
  "env": {
    "NODE_ENV": "production",
    "JWT_SECRET": "your-super-secret-key-min-32-chars",
    "CORS_ORIGIN": "https://yourdomain.vercel.app,https://yourdomain.com",
    "PORT": "5000"
  },
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
